{
  "name": "portfolio-page-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @portfolio/web",
    "dev:studio": "npm run dev --workspace @portfolio/studio",
    "draft:token": "tsx scripts/create-draft-token.ts",
    "content:export": "tsx scripts/sanity-recovery.ts export",
    "content:restore": "tsx scripts/sanity-recovery.ts restore",
    "build": "npm run build:web && npm run build:studio",
    "build:web": "npm run build --workspace @portfolio/web",
    "build:studio": "npm run build --workspace @portfolio/studio",
    "typegen": "npm run typegen --workspace @portfolio/studio",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts tests/*.test.tsx",
    "check:generated": "npm run typegen && git diff --exit-code -- apps/studio/schema.json packages/content/src/generated/sanity.types.ts",
    "check:dependencies": "node scripts/dependency-audit.mjs",
    "check:secrets": "secretlint \"**/*\"",
    "check": "npm run check:generated && npm run typecheck && npm test && npm run check:dependencies && npm run check:secrets && npm run build"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@xmldom/xmldom": "0.9.10",
    "jsdom": "27.0.0",
    "secretlint": "13.0.4",
    "shadcn": "4.16.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
